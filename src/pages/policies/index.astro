---
import '../../styles/global.css';
import '../../styles/legal.css';
---

<!DOCTYPE html>
<html lang="it">
<head>
    <script is:inline src="https://app.termly.io/resource-blocker/bc13f957-c21f-4ed9-ba27-fc67ff4d7baa?autoBlock=on"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <title>Policies | _davstudios</title>
    <meta name="robots" content="noindex, follow">
    <meta property="article:modified_time" content="2026-07-13T12:10:00+01:00" />
    <meta property="article:published_time" content="2026-07-13T12:10:00+01:00" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,300&display=swap" rel="stylesheet">

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-S58P45NFC2"></script>
    <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-S58P45NFC2');
    </script>
</head>
<body>

    <nav class="navbar">
        <div class="nav-section nav-left">
            <a href="/chi-sono">CHI SONO</a>
            <a href="/p&p">P&amp;P</a>
        </div>
        <div class="nav-logo">
            <a href="/">
                <img src="/assets/_davstudios.svg" alt="_davstudios" class="nav-logo-img"/>
            </a>
        </div>
        <div class="nav-section nav-right">
            <a href="/fontshop">FONTSHOP</a>
            <a href="/contattami" class="btn-contattami">CONTATTAMI</a>
        </div>
        <button class="nav-hamburger" aria-label="Menu" aria-expanded="false">
            <span></span><span></span><span></span>
        </button>
    </nav>

    <div class="nav-drawer" id="nav-drawer">
        <div class="nav-drawer__inner">
            <a href="/chi-sono">CHI SONO</a>
            <a href="/p&p">P&amp;P</a>
            <a href="/fontshop">FONTSHOP</a>
            <a href="/contattami" class="btn-contattami">CONTATTAMI</a>
        </div>
    </div>

    <div class="nav-overlay" id="nav-overlay"></div>

    <header class="policies-hero">
        <span class="policies-hero__label" style="animation:fadeUp .6s .05s var(--ease) both">
            Documenti legali
        </span>
        <h1 class="policies-hero__title" style="animation:fadeUp .75s .12s var(--ease) both">
            Le nostre<br>
            <span class="policies-hero__em">Policies.</span>
        </h1>
        <p class="policies-hero__sub" style="animation:fadeUp .75s .22s var(--ease) both">
            Tutto quello che devi sapere su come gestiamo cookie, dati personali
            e resi — in modo trasparente e senza fronzoli.
        </p>
    </header>

    <hr class="policies-divider" />

    <div class="policies-grid">

        <a href="/policies/cookie-policy" class="policy-card reveal">
            <div class="policy-card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2a10 10 0 1 0 10 10c0-1.5-.5-2.5-1.5-3.5A3.5 3.5 0 0 1 17 5c0-1.5-1-2.5-3-3.5A7.5 7.5 0 0 0 12 2z"/>
                    <circle cx="8" cy="10" r="1" fill="currentColor"/>
                    <circle cx="12" cy="14" r="1" fill="currentColor"/>
                    <circle cx="8" cy="16" r="1" fill="currentColor"/>
                    <circle cx="16" cy="12" r="1" fill="currentColor"/>
                    <circle cx="15" cy="17" r="1" fill="currentColor"/>
                </svg>
            </div>
            <p class="policy-card__tag">Documento legale · v1.0</p>
            <h2 class="policy-card__title">Cookie Policy</h2>
            <p class="policy-card__desc">
                Cosa sono i cookie, quali categorie utilizziamo (essenziali, analitici,
                funzionali e di targeting), come puoi gestire le tue preferenze e come
                disabilitarli dal browser in qualsiasi momento.
            </p>
            <span class="policy-card__cta">
                Leggi il documento
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                </svg>
            </span>
        </a>

        <a href="/policies/privacy-policy" class="policy-card reveal">
            <div class="policy-card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <path d="m9 11 2 2 4-4"/>
                </svg>
            </div>
            <p class="policy-card__tag">Documento legale · v1.0</p>
            <h2 class="policy-card__title">Privacy Policy</h2>
            <p class="policy-card__desc">
                Come raccogliamo, utilizziamo e proteggiamo i tuoi dati personali
                in conformità al GDPR (Reg. UE 2016/679). I tuoi diritti di accesso,
                rettifica e cancellazione, e chi contattare per esercitarli.
            </p>
            <span class="policy-card__cta">
                Leggi il documento
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                </svg>
            </span>
        </a>

        <a href="/policies/return-policy" class="policy-card reveal">
            <div class="policy-card__icon">
                <!-- Icona Return Ottimizzata e Bilanciata -->
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <!-- Un arco di cerchio perfetto e aperto in alto a destra -->
                    <path d="M21.5 12a9.5 9.5 0 1 1-2.78-6.72L21.5 8" />
                    <!-- La punta della freccia, geometrica e pulita -->
                    <polyline points="16.5 8 21.5 8 21.5 3" />
                </svg>

            </div>
            <p class="policy-card__tag">Documento legale · v1.0</p>
            <h2 class="policy-card__title">Return Policy</h2>
            <p class="policy-card__desc">
                Condizioni e procedura per richiedere un rimborso sui prodotti digitali
                acquistati nel font shop — inclusi i termini di eligibilità, le tempistiche
                e le eccezioni previste per le licenze già attivate.
            </p>
            <span class="policy-card__cta">
                Leggi il documento
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                </svg>
            </span>
        </a>

    </div>

    <footer class="main-footer">
        <div class="footer-logo">
            <a href="/">
                <img src="/assets/_davstudios.svg" alt="_davstudios" class="footer-logo-img"/>
            </a>
        </div>
        <nav class="footer-nav">
            <a href="/chi-sono">CHI SONO</a>
            <a href="/p&p">P&amp;P</a>
            <a href="/fontshop">FONTSHOP</a>
            <a href="/contattami">CONTATTAMI</a>
            <a href="#" class="nav-active">POLICIES</a>
        </nav>
        <div class="footer-copyright">
            <p>© 2026 <a href="https://www.instagram.com/_davstudios/" style="color:var(--ink);text-decoration:none">_davstudios</a> — Tutti i diritti riservati</p>
        </div>
    </footer>

    <script>
        import '../../scripts/global.js';
        import '../../scripts/legal.js';
    </script>

</body>
</html>