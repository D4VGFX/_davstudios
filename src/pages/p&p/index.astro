---
import '../../styles/global.css';
import '../../styles/p&p.css';
---

<!DOCTYPE html>
<html lang="it">
<head>
    <script is:inline src="https://app.termly.io/resource-blocker/bc13f957-c21f-4ed9-ba27-fc67ff4d7baa?autoBlock=on"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta property="article:modified_time" content="2026-07-13T12:10:00+01:00" />
    <meta property="article:published_time" content="2026-07-13T12:10:00+01:00" />

    <!-- SEO primari -->
    <title>Progetti & Processo | _davstudios</title>
    <meta name="description" content="Esplora i progetti di _davstudios e scopri il processo creativo dietro ogni lavoro. Design, web development e metodo al servizio del tuo brand.">
    <meta name="author" content="David Spano">
    <meta name="robots" content="index, follow">
    <meta name="language" content="it">
    <link rel="canonical" href="https://davstudios.it/pp/">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://davstudios.it/pp/">
    <meta property="og:title" content="Progetti & Processo | _davstudios">
    <meta property="og:description" content="Esplora i progetti di _davstudios e scopri il processo creativo dietro ogni lavoro.">
    <meta property="og:image" content="https://davstudios.it/assets/og-image.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:site_name" content="_davstudios">
    <meta property="og:locale" content="it_IT">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Progetti & Processo | _davstudios">
    <meta name="twitter:description" content="Esplora i progetti di _davstudios e scopri il processo creativo dietro ogni lavoro.">
    <meta name="twitter:image" content="https://davstudios.it/assets/og-image.jpg">

    <!-- Favicon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <meta name="theme-color" content="#0071E3">

    <!-- Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,300&display=swap" rel="stylesheet">

    <!-- Google tag -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-S58P45NFC2"></script>
    <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-S58P45NFC2');
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "Progetti & Processo | _davstudios",
      "url": "https://davstudios.it/pp/",
      "description": "Esplora i progetti di _davstudios e scopri il processo creativo dietro ogni lavoro.",
      "author": { "@type": "Person", "name": "David Spano" }
    }
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://davstudios.it/" },
        { "@type": "ListItem", "position": 2, "name": "Progetti & Processo", "item": "https://davstudios.it/pp/" }
      ]
    }
    </script>

</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar">
        <div class="nav-section nav-left">
            <a href="/chi-sono">CHI SONO</a>
            <a href="#" class="nav-active">P&amp;P</a>
        </div>
        <div class="nav-logo">
            <a href="/">
                <img src="/assets/_davstudios.svg" alt="_davstudios" class="nav-logo-img"/>
            </a>
        </div>
        <div class="nav-section nav-right">
            <a href="/fontshop">FONTSHOP</a>
            <a href="/contattami" class="btn-contattami">CONTATTAMI</a>
        </div>
        <button class="nav-hamburger" aria-label="Menu" aria-expanded="false">
            <span></span><span></span><span></span>
        </button>
    </nav>
    <div class="nav-drawer" id="nav-drawer">
        <div class="nav-drawer__inner">
            <a href="/chi-sono">CHI SONO</a>
            <a href="#" class="nav-active">P&amp;P</a>
            <a href="/fontshop">FONTSHOP</a>
            <a href="/contattami" class="btn-contattami">CONTATTAMI</a>
        </div>
    </div>
    <div class="nav-overlay" id="nav-overlay"></div>

    <!-- HERO -->
    <header class="pp-hero">
        <p class="pp-hero__label reveal">Il mio lavoro</p>
        <h1 class="pp-hero__title reveal delay-1">
            Progetti<br><em>&amp; Processo.</em>
        </h1>
        <p class="pp-hero__sub reveal delay-2">
            Quello che ho realizzato e come lo realizzo.
            Due facce dello stesso approccio — visione, metodo e cura
            per ogni singolo progetto.
        </p>
    </header>

    <div class="pp-divider reveal delay-3"></div>

    <!-- SPLIT CARDS -->
    <div class="pp-split">

        <!-- Card Progetti -->
        <a href="/p&p/progetti" class="pp-card pp-card--progetti reveal delay-3">
            <span class="pp-card__num">01 — Progetti</span>

            <svg class="pp-card__icon" viewBox="0 0 52 52" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="4" y="4" width="20" height="20" rx="4" stroke="white" stroke-width="1.5"/>
                <rect x="28" y="4" width="20" height="20" rx="4" stroke="white" stroke-width="1.5"/>
                <rect x="4" y="28" width="20" height="20" rx="4" stroke="white" stroke-width="1.5"/>
                <rect x="28" y="28" width="20" height="20" rx="4" stroke="white" stroke-width="1.5"/>
            </svg>

            <h2 class="pp-card__title">Il lavoro<br>realizzato.</h2>
            <p class="pp-card__sub">Portfolio</p>
            <p class="pp-card__desc">
                Identità visive, siti web e grafiche per clienti reali.
                Ogni progetto è una storia concreta: un brand che prende forma,
                una presenza digitale che comunica.
            </p>
            <div class="pp-card__tags">
                <span class="pp-card__tag">Graphic Design</span>
                <span class="pp-card__tag">Web Design</span>
                <span class="pp-card__tag">Branding</span>
            </div>
            <span class="pp-card__cta">
                <span class="pp-card__cta-inner">
                    Esplora i progetti
                    <span class="pp-card__arrow">→</span>
                </span>
                <span class="pp-card__cta-line" aria-hidden="true"></span>
            </span>
        </a>

        <!-- Card Processo -->
        <a href="/p&p/processo" class="pp-card pp-card--processo reveal delay-4">
            <span class="pp-card__num">02 — Processo</span>

            <svg class="pp-card__icon" viewBox="0 0 52 52" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="26" cy="26" r="20" stroke="#1D1D1F" stroke-width="1.5"/>
                <path d="M26 14v12l8 5" stroke="#1D1D1F" stroke-width="1.5" stroke-linecap="round"/>
            </svg>

            <h2 class="pp-card__title">Come funziona<br>il metodo.</h2>
            <p class="pp-card__sub">6 fasi</p>
            <p class="pp-card__desc">
                Dal primo ascolto al lancio finale, ogni fase ha uno scopo preciso.
                Nessuna improvvisazione — solo metodo, trasparenza
                e iterazioni fino alla perfezione.
            </p>
            <div class="pp-card__tags">
                <span class="pp-card__tag">Ascolto</span>
                <span class="pp-card__tag">Strategia</span>
                <span class="pp-card__tag">Design</span>
                <span class="pp-card__tag">Sviluppo</span>
            </div>
            <span class="pp-card__cta">
                <span class="pp-card__cta-inner">
                    Scopri il processo
                    <span class="pp-card__arrow">→</span>
                </span>
                <span class="pp-card__cta-line" aria-hidden="true"></span>
            </span>
        </a>

    </div>

    <!-- STATS STRIP -->
    <div class="pp-stats">
        <div class="pp-stat reveal delay-3">
            <span class="pp-stat__num">47+</span>
            <span class="pp-stat__label">Progetti completati</span>
        </div>
        <div class="pp-stat reveal delay-4">
            <span class="pp-stat__num">6</span>
            <span class="pp-stat__label">Fasi del processo</span>
        </div>
        <div class="pp-stat reveal delay-5">
            <span class="pp-stat__num">100%</span>
            <span class="pp-stat__label">Trasparenza con il cliente</span>
        </div>
    </div>

    <!-- CTA BOTTOM -->
    <section class="pp-cta">
        <p class="pp-cta__label reveal">Pronto a iniziare?</p>
        <h2 class="pp-cta__title reveal delay-1">Hai un progetto in mente?</h2>
        <p class="pp-cta__sub reveal delay-2">
            Raccontami la tua idea — rispondo entro 24 ore con un piano chiaro.
        </p>
        <div class="pp-cta__actions reveal delay-3">
            <a href="/contattami" class="btn-oval">Inizia il tuo progetto</a>
            <a href="/chi-sono" class="btn-ghost">Chi sono →</a>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="main-footer">
        <div class="footer-logo">
            <a href="/">
                <img src="/assets/_davstudios.svg" alt="_davstudios" class="footer-logo-img"/>
            </a>
        </div>
        <nav class="footer-nav">
            <a href="/chi-sono">CHI SONO</a>
            <a href="#" class="nav-active">P&amp;P</a>
            <a href="/fontshop">FONTSHOP</a>
            <a href="/contattami">CONTATTAMI</a>
            <a href="/policies">POLICIES</a>
        </nav>
        <div class="footer-copyright">
            <p>© 2026 <a href="https://www.instagram.com/_davstudios/" style="color:var(--ink);text-decoration:none">_davstudios</a> — Tutti i diritti riservati</p>
        </div>
    </footer>

    <script>
        import '../../scripts/global.js';
        import '../../scripts/announcement.js';

        // Reveal on scroll
        const revealEls = document.querySelectorAll('.reveal');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(e => {
                if (e.isIntersecting) {
                    e.target.classList.add('visible');
                    observer.unobserve(e.target);
                }
            });
        }, { threshold: 0.12 });
        revealEls.forEach(el => observer.observe(el));
    </script>

</body>
</html>