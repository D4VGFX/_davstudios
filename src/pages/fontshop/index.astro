---
import '../../styles/global.css';
import '../../styles/fontshop.css';
---

<!DOCTYPE html>
<html lang="it">
<head>
    <script is:inline src="https://app.termly.io/resource-blocker/bc13f957-c21f-4ed9-ba27-fc67ff4d7baa?autoBlock=on"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta property="article:modified_time" content="2026-06-05T19:00:00+01:00" />
    <meta property="article:published_time" content="2026-06-05T19:05:00+01:00" />

    <title>FontShop | _davstudios</title>
    <meta name="description" content="Font originali con licenza su misura. Acquista typeface professionali firmati _davstudios per uso personale, commerciale, app e broadcast.">
    <meta name="author" content="David Spano">
    <meta name="robots" content="index, follow">
    <meta name="language" content="it">
    <link rel="canonical" href="https://davstudios.it/fontshop/">

    <meta property="og:type" content="website">
    <meta property="og:url" content="https://davstudios.it/fontshop/">
    <meta property="og:title" content="FontShop | _davstudios">
    <meta property="og:description" content="Font originali con licenza su misura. Acquista typeface professionali firmati _davstudios.">
    <meta property="og:image" content="https://davstudios.it/assets/og-image.jpg">
    <meta property="og:site_name" content="_davstudios">
    <meta property="og:locale" content="it_IT">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="FontShop | _davstudios">
    <meta name="twitter:description" content="Font originali con licenza su misura firmati _davstudios.">
    <meta name="twitter:image" content="https://davstudios.it/assets/og-image.jpg">

    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <meta name="theme-color" content="#0071E3">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,300&display=swap" rel="stylesheet">

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-S58P45NFC2"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-S58P45NFC2');
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Store",
      "name": "FontShop | _davstudios",
      "url": "https://davstudios.it/fontshop/",
      "description": "Font originali con licenza su misura firmati _davstudios.",
      "author": { "@type": "Person", "name": "David Spano" }
    }
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://davstudios.it/" },
        { "@type": "ListItem", "position": 2, "name": "FontShop", "item": "https://davstudios.it/fontshop/" }
      ]
    }
    </script>
</head>
<body>

    <nav class="navbar">
                <div class="nav-section nav-left">
            <a href="/chi-sono">CHI SONO</a>
            <a href="/p&p">P&amp;P</a>
        </div>
        <div class="nav-logo">
            <a href="/">
                <img src="/assets/_davstudios.svg" alt="_davstudios" class="nav-logo-img"/>
            </a>
        </div>
                <div class="nav-section nav-right">
            <a href="/fontshop" class="nav-active">FONTSHOP</a>
            <a href="/contattami" class="btn-contattami">CONTATTAMI</a>
        </div>
        <button class="nav-hamburger" aria-label="Menu" aria-expanded="false">
            <span></span><span></span><span></span>
        </button>
    </nav>
        <div class="nav-drawer" id="nav-drawer">
        <div class="nav-drawer__inner">
            <a href="/chi-sono">CHI SONO</a>
            <a href="/p&p">P&amp;P</a>
            <a href="/fontshop" class="nav-active">FONTSHOP</a>
            <a href="/contattami" class="btn-contattami">CONTATTAMI</a>
        </div>
    </div>

    <div class="nav-overlay" id="nav-overlay"></div>

    <!-- HERO -->
    <header class="fs-hero">
        <div class="fs-hero__inner">
            <div class="fs-hero__text">
                <p class="fs-hero__label reveal">Type design originale</p>
                <h1 class="fs-hero__title reveal delay-1">
                    Font.<br><span class="fs-hero__em">Con licenza.</span>
                </h1>
                <p class="fs-hero__sub reveal delay-2">
                    Typeface originali progettati con cura.
                    Ogni font viene fornito con licenza su misura —
                    scegli quella adatta al tuo progetto e scarica subito.
                </p>
                <div class="fs-hero__badges reveal delay-3">
                    <span class="fs-badge">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="1"/></svg>
                        Pagamento sicuro Stripe
                    </span>
                    <span class="fs-badge">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        Consegna via email
                    </span>
                    <span class="fs-badge">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                        Licenza PDF inclusa
                    </span>
                </div>
            </div>
            <div class="fs-hero__specimen reveal delay-2" aria-hidden="true">
                <div class="fs-specimen-card">
                    <span class="fs-specimen-label">Aa</span>
                    <div class="fs-specimen-chars">ABCDEFG<br>abcdefg<br>0123456</div>
                </div>
            </div>
        </div>
    </header>

    <!-- FONT GRID -->
    <section class="fs-catalog" id="fs-catalog">
        <div class="fs-catalog__inner">
            <div class="fs-catalog__head reveal">
                <p class="section-label">Catalogo</p>
                <h2 class="fs-catalog__title">I miei font</h2>
                <p class="fs-catalog__sub">Ogni typeface nasce da un progetto di ricerca visiva. Disponibili in 6 livelli di licenza.</p>
            </div>

            <div class="fs-grid">

                <!-- ALEXANDRIA -->
                <a href="/fontshop/alexandria" class="fs-card reveal">
                    <div class="fs-card__preview">
                        <div class="fs-card__specimen fs-card__specimen--alexandria">
                            <span>Alexandria</span>
                        </div>
                        <div class="fs-card__overlay">
                            <span class="fs-card__cta">Scopri il font →</span>
                        </div>
                    </div>
                    <div class="fs-card__body">
                        <div class="fs-card__meta">
                            <span class="fs-card__tag">Serif</span>
                            <span class="fs-card__tag">Elegante</span>
                        </div>
                        <h3 class="fs-card__name">Alexandria</h3>
                        <p class="fs-card__desc">Un serif elegante con glifi sinuosi e raffinati. Sofisticato, senza tempo, perfetto per progetti di lusso.</p>
                        <div class="fs-card__footer">
                            <span class="fs-card__from">Da <strong>€19,99</strong></span>
                            <span class="fs-card__licenses">6 licenze disponibili</span>
                        </div>
                    </div>
                </a>

                <!-- PLACEHOLDER 1 -->
                <a href="/fontshop/nexora-sans" class="fs-card reveal">
                    <div class="fs-card__preview">
                        <div class="fs-card__specimen fs-card__specimen--nexora-sans">
                            <span>NexoraSans</span>
                        </div>
                        <div class="fs-card__overlay">
                            <span class="fs-card__cta">Scopri il font →</span>
                        </div>
                    </div>
                    <div class="fs-card__body">
                        <div class="fs-card__meta">
                            <span class="fs-card__tag">Sans Serif</span>
                            <span class="fs-card__tag">Geometrico</span>
                        </div>
                        <h3 class="fs-card__name">NexoraSans</h3>
                        <p class="fs-card__desc">Un sans-serif geometrico ispirato alla pulizia delle forme circolari e alla fluidità del segno contemporaneo.</p>
                        <div class="fs-card__footer">
                            <span class="fs-card__from">Da <strong>€24,99</strong></span>
                            <span class="fs-card__licenses">6 licenze disponibili</span>
                        </div>
                    </div>
                </a>

                <!-- PLACEHOLDER 2 -->
                <div class="fs-card fs-card--soon reveal delay-2">
                    <div class="fs-card__preview fs-card__preview--soon">
                        <div class="fs-card__soon-label">Prossimamente</div>
                    </div>
                    <div class="fs-card__body">
                        <div class="fs-card__meta">
                            <span class="fs-card__tag fs-card__tag--muted">In sviluppo</span>
                        </div>
                        <h3 class="fs-card__name fs-card__name--muted">— — —</h3>
                        <p class="fs-card__desc">Un nuovo typeface in arrivo. Seguimi per scoprirlo in anteprima.</p>
                        <div class="fs-card__footer">
                            <span class="fs-card__from fs-card__from--muted">Presto disponibile</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- COME FUNZIONA -->
    <section class="fs-how">
        <div class="fs-how__inner">
            <div class="fs-how__head reveal">
                <p class="section-label">Come funziona</p>
                <h2 class="section-title">Semplice e immediato.</h2>
            </div>
            <div class="fs-how__steps">
                <div class="fs-step reveal">
                    <div class="fs-step__num">01</div>
                    <div class="fs-step__body">
                        <h3 class="fs-step__title">Scegli il font</h3>
                        <p class="fs-step__text">Esplora il catalogo, visualizza lo specimen e scegli il typeface adatto al tuo progetto.</p>
                    </div>
                </div>
                <div class="fs-step__connector" aria-hidden="true"></div>
                <div class="fs-step reveal delay-1">
                    <div class="fs-step__num">02</div>
                    <div class="fs-step__body">
                        <h3 class="fs-step__title">Seleziona la licenza</h3>
                        <p class="fs-step__text">Scegli il piano di licenza in base all'uso: personale, commerciale, app, broadcast o enterprise.</p>
                    </div>
                </div>
                <div class="fs-step__connector" aria-hidden="true"></div>
                <div class="fs-step reveal delay-2">
                    <div class="fs-step__num">03</div>
                    <div class="fs-step__body">
                        <h3 class="fs-step__title">Paga in sicurezza</h3>
                        <p class="fs-step__text">Checkout gestito da Stripe — carta di credito, Apple Pay, Google Pay. Nessun dato salvato.</p>
                    </div>
                </div>
                <div class="fs-step__connector" aria-hidden="true"></div>
                <div class="fs-step reveal delay-3">
                    <div class="fs-step__num">04</div>
                    <div class="fs-step__body">
                        <h3 class="fs-step__title">Ricevi via email</h3>
                        <p class="fs-step__text">Subito dopo il pagamento ricevi il font in .zip con la licenza PDF firmata all'email indicata.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ LICENZE -->
    <section class="fs-faq">
        <div class="fs-faq__inner">
            <div class="fs-faq__head reveal">
                <p class="section-label">Licenze</p>
                <h2 class="section-title">Domande frequenti.</h2>
            </div>
            <div class="fs-faq__grid">
                <div class="fs-faq__item reveal">
                    <h3 class="fs-faq__q">Posso usare il font per un logo?</h3>
                    <p class="fs-faq__a">Sì, dalla licenza Commercial in su. La Personal è solo per uso privato non commerciale.</p>
                </div>
                <div class="fs-faq__item reveal delay-1">
                    <h3 class="fs-faq__q">Ho bisogno di più siti web?</h3>
                    <p class="fs-faq__a">La licenza Commercial copre fino a 1 sito. Per più domini o installazioni su prodotti digitali multipli serve la Extended o SaaS.</p>
                </div>
                <div class="fs-faq__item reveal delay-2">
                    <h3 class="fs-faq__q">Posso incorporarlo in un'app?</h3>
                    <p class="fs-faq__a">Sì, con la licenza SaaS/App. Questa copre applicazioni mobile, software desktop e prodotti digitali distribuiti.</p>
                </div>
                <div class="fs-faq__item reveal delay-3">
                    <h3 class="fs-faq__q">Posso usarlo in TV o video?</h3>
                    <p class="fs-faq__a">Sì, con la licenza Broadcast. Copre produzioni video, streaming, spot pubblicitari e trasmissioni televisive.</p>
                </div>
                <div class="fs-faq__item reveal">
                    <h3 class="fs-faq__q">Come ricevo i file?</h3>
                    <p class="fs-faq__a">Immediatamente dopo il pagamento ricevi un'email con allegato lo .zip contenente il font e la licenza PDF.</p>
                </div>
                <div class="fs-faq__item reveal delay-1">
                    <h3 class="fs-faq__q">Posso aggiornare la licenza in seguito?</h3>
                    <p class="fs-faq__a">Sì, contattami via email. Calcolo la differenza di prezzo e non devi riacquistare il font da zero.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA FINALE -->
    <section class="fs-cta">
        <div class="fs-cta__inner reveal">
            <p class="fs-cta__label">Pronto ad iniziare?</p>
            <h2 class="fs-cta__title">Scegli il tuo<br><span>primo font.</span></h2>
            <p class="fs-cta__sub">Consegna immediata. Licenza chiara. Qualità garantita.</p>
            <a href="#fs-catalog" class="btn-oval">Esplora il catalogo</a>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="main-footer">
        <div class="footer-logo">
            <a href="/">
                <img src="/assets/_davstudios.svg" alt="_davstudios" class="footer-logo-img"/>
            </a>
        </div>
                <nav class="footer-nav">
            <a href="/chi-sono">CHI SONO</a>
            <a href="/p&p">P&amp;P</a>
            <a href="/fontshop" class="nav-active">FONTSHOP</a>
            <a href="/contattami">CONTATTAMI</a>
            <a href="/policies">POLICIES</a>
        </nav>
        <div class="footer-copyright">
            <p>© 2026 <a href="https://www.instagram.com/_davstudios/" style="color:var(--ink);text-decoration:none">_davstudios</a> — Tutti i diritti riservati</p>
        </div>
    </footer>

    <script>
        import '../../scripts/global.js';
        import '../../scripts/fontshop.js';
        import '../../scripts/announcement.js';
    </script>

</body>
</html>